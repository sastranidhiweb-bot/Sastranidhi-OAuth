@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap');

:root {
  --brand-deep: #21163F;
  --brand-violet: #45218B;
  --brand-violet-light: #6933C9;
  --brand-gold: #E8C34A;
  --brand-gold-soft: #F3DFA0;
  --white: #FFFFFF;
  --lavender-light: #F3F0FA;
  --lavender: #ECE7F7;
  --lavender-soft: #DED7EE;
  --lavender-muted: #C9C1DF;
  --lavender-subtle: #B9B0CC;
  --text-primary: #20154A;
  --text-secondary: #625A76;
  --text-muted: #716A82;
  --sn-gradient: linear-gradient(115deg, #29135D 0%, #402080 43%, #6B32C6 100%);
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  color: var(--text-primary);
  background:
    radial-gradient(circle at 7% 8%, rgba(92,47,160,.16), transparent 25%),
    radial-gradient(circle at 94% 10%, rgba(112,63,191,.13), transparent 25%),
    linear-gradient(135deg, #ebe5f5 0%, #ded5ed 42%, #eee9f6 70%, #e3dced 100%);
  font-family: 'Inter', system-ui, sans-serif;
  line-height: 1.55;
}
h1, h2, h3, h4 { font-family: 'Cormorant Garamond', Georgia, serif; }
a { color: inherit; }
img { max-width: 100%; display: block; }
.wrap { max-width: 1160px; margin: 0 auto; padding: 0 28px; }
section { position: relative; padding: 76px 0; overflow: hidden; }
section:not(.hero)::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  width: min(720px, 80vw);
  height: 1px;
  transform: translateX(-50%);
  background: linear-gradient(90deg, transparent, rgba(101,64,181,.18), rgba(232,195,74,.16), transparent);
}

/* Header — scrolls away normally, NOT sticky (matches HTML) */
header {
  position: relative;
  z-index: 50;
  padding: 10px 0;
  overflow: hidden;
  background: linear-gradient(110deg, rgba(27,13,55,.98), rgba(46,22,86,.98)) !important;
  box-shadow: 0 4px 22px rgba(22,9,49,.24);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}
header::before {
  content: '';
  position: absolute;
  inset: 0 auto 0 -35%;
  width: 30%;
  background: linear-gradient(100deg, transparent, rgba(255,255,255,.08), transparent);
  transform: skewX(-18deg);
  animation: navSheen 9s ease-in-out infinite;
  pointer-events: none;
}
header::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--brand-gold), transparent);
  background-size: 200% 100%;
  animation: gopuramGlow 6s ease-in-out infinite;
}
.nav { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
.brand { display: flex; align-items: center; gap: 12px; text-decoration: none; }
.brand .glyph { position: relative; width: 64px; height: 64px; display: grid; place-items: center; isolation: isolate; }
.brand .glyph::before, .brand .glyph::after { content: ''; position: absolute; border-radius: 50%; pointer-events: none; }
.brand .glyph::before { inset: -5px; border: 1px solid rgba(232,195,74,.5); border-left-color: transparent; border-bottom-color: rgba(232,195,74,.16); animation: logoOrbit 7s linear infinite; }
.brand .glyph::after { inset: -9px; border: 1px dashed rgba(255,255,255,.22); border-right-color: transparent; border-top-color: transparent; animation: logoOrbitReverse 11s linear infinite; }
.brand .glyph img { position: relative; z-index: 2; width: 58px; height: 58px; border-radius: 0; object-fit: contain; box-shadow: 0 0 0 2px rgba(255,255,255,.08), 0 0 22px rgba(232,195,74,.22), 0 7px 20px rgba(19,11,41,.35); animation: logoBreath 3.8s ease-in-out infinite; }
.brand .name { color: #FFFFFF !important; font-family: 'Cormorant Garamond', serif; font-size: 20px; font-weight: 700; letter-spacing: .075em; text-shadow: 0 1px 2px rgba(0,0,0,.45), 0 0 12px rgba(255,255,255,.16); }
.brand .sub { color: #F2E9FF !important; font-size: 10.5px; font-weight: 600; letter-spacing: 1.6px; text-shadow: 0 1px 4px rgba(0,0,0,.32); }
nav.links { display: flex; align-items: center; gap: 28px; }
nav.links a { position: relative; padding-bottom: 4px; color: #F4ECFF !important; font-size: 16.0px; font-weight: 600; text-decoration: none; }
nav.links a::after { content: ''; position: absolute; left: 0; bottom: -4px; width: 0; height: 1.5px; background: var(--brand-gold); transition: width .3s ease; }
nav.links a:hover { color: #FFFFFF !important; }
nav.links a:hover::after { width: 100%; }
.btn-donate { border: 0; border-radius: 999px; padding: 10px 22px; background: linear-gradient(120deg, var(--brand-violet), var(--brand-violet-light)); color: #FFFFFF; font-size: 14px; font-weight: 700; cursor: pointer; text-decoration: none; }
.hamburger { display: none; flex-direction: column; gap: 5px; width: 34px; height: 34px; padding: 0; border: 0; background: none; cursor: pointer; }
.hamburger span { display: block; width: 100%; height: 2px; background: #F3F0FA; }
.mobile-nav { display: none; flex-direction: column; gap: 2px; padding: 10px 28px 18px; }
.mobile-nav.open { display: flex; }
.mobile-nav a { padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,.14); color: #F3F0FA; text-decoration: none; }

/* Hero */
.hero { min-height: 208px; padding: 52px 0 74px; text-align: center; background: linear-gradient(125deg, #241044 0%, #321765 42%, #4b238f 75%, #5e2cad 100%); }
.hero::before { content: ''; position: absolute; width: 420px; height: 420px; left: -180px; top: -230px; border: 1px solid rgba(233,196,90,.17); border-radius: 50%; box-shadow: 0 0 0 42px rgba(233,196,90,.025), 0 0 0 84px rgba(233,196,90,.018); animation: heroOrbit 18s linear infinite; }
.hero::after { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 18% 24%, rgba(214,194,255,.10) 0 2px, transparent 3px), radial-gradient(circle at 76% 20%, rgba(255,255,255,.10) 0 1px, transparent 2px); background-size: 170px 150px, 230px 190px; animation: heroSparkle 18s linear infinite; }
.hero-clouds { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 1; }
.hero-cloud { position: absolute; width: 190px; height: 58px; border-radius: 999px; background: linear-gradient(180deg, rgba(255,255,255,.24), rgba(214,219,236,.06)); filter: blur(1px); opacity: .5; }
.hero-cloud::before, .hero-cloud::after { content: ''; position: absolute; border-radius: 50%; background: inherit; }
.hero-cloud::before { width: 92px; height: 92px; left: 28px; bottom: 8px; }
.hero-cloud::after { width: 118px; height: 118px; right: 24px; bottom: 0; }
.hero-cloud:nth-child(1) { top: 18%; left: -230px; animation: cloudDrift 46s linear infinite; }
.hero-cloud:nth-child(2) { top: 38%; left: -300px; opacity: .28; animation: cloudDrift 64s linear infinite -18s; }
.hero-cloud:nth-child(3) { top: 12%; left: -260px; opacity: .24; animation: cloudDrift 55s linear infinite -31s; }
.hero-inner { position: relative; z-index: 2; }
.hero h1 { position: relative; z-index: 2; margin: 0 0 12px; color: var(--brand-gold); font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(40px, 4.2vw, 54px); line-height: 1.1; text-transform: uppercase; letter-spacing: 1px; opacity: 1; text-shadow: 0 0 30px rgba(232,195,74,.10); }
.hero .lede { position: relative; z-index: 2; max-width: 650px; margin: 0 auto; color: #F3F0FA; font-size: 16px; line-height: 1.5; }
.gopuram-arch { position: relative; z-index: 2; height: 6px; }
.hero-curve { position: absolute; left: -10%; right: -10%; bottom: -1px; height: 48px; background: var(--lavender-light); border-radius: 50% 50% 0 0 / 100% 100% 0 0; z-index: 3; }

/* Core sections */
#platforms { padding: 50px 0 58px; background: #F5F2FB; }
.section-head { max-width: 640px; margin: 0 auto 44px; text-align: center; }
.section-head h2 { margin: 0; font-size: clamp(38px,4.3vw,48px); }
.section-head p { margin: 12px auto 0; color: var(--text-muted); }
.kicker { margin-bottom: 10px; color: var(--brand-violet); font-size: 12.5px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; }
.tablet-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 26px; }
.tablet { min-height: 382px; padding: 26px 24px; border: 1px solid #DDD5EE; background: #FFFFFF; box-shadow: none; }
.tablet .icon { width: 46px; height: 46px; margin-bottom: 18px; display: grid; place-items: center; border-radius: 0; background: #21114F; color: var(--brand-gold); font-family: 'Cormorant Garamond', serif; font-size: 18px; font-weight: 700; }
.tablet h3 { font-size: 18px; line-height: 1.5; margin: 0 0 10px; }
.tablet p { color: var(--text-muted); font-size: 14px; line-height: 1.65; }
.tablet a { color: var(--brand-violet); font-size: 14px; font-weight: 700; text-decoration: none; }
.stats-band { padding: 46px 0; background: var(--sn-gradient); }
.stats-grid { display: grid; grid-template-columns: repeat(5,1fr); }
.stat-item { padding: 6px 18px; text-align: center; }
.stat-icon { display: block; margin-bottom: 6px; font-size: 20px; }
.stats-grid .num { display: block; color: var(--brand-gold); font-family: 'Cormorant Garamond', serif; font-size: 34px; font-weight: 700; }
.stats-grid .lbl { color: var(--lavender-soft); font-size: 13px; margin-top: 4px; }

/* About, initiatives, courses, research, subscribe, contact, footer */
.about-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 56px; align-items: start; }
.about-grid h2 { font-size: clamp(28px,3.6vw,38px); margin-bottom: 18px; }
.about-grid p { color: var(--text-secondary); font-size: 15.5px; }
.vision-card { padding: 32px; border-radius: 16px; background: var(--sn-gradient); color: #FFFFFF; }
.vision-card h3 { color: #FFFFFF; margin-bottom: 10px; }
.vision-card p { color: var(--lavender-soft); }
.vision-card .quote { color: var(--brand-gold); font-style: italic; }
.course-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 22px; }
.course { overflow: hidden; border: 1px solid rgba(90,46,166,.1); border-radius: 16px; background: #FFFFFF; }
.course .head { padding: 20px 22px; background: linear-gradient(135deg, var(--lavender), var(--brand-gold-soft)); }
.course .level { color: var(--brand-violet); font-size: 11.5px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; }
.course .head h3 { font-size: 18px; }
.course .body { padding: 20px 22px; }
.course .meta { display: flex; gap: 10px; color: var(--lavender-subtle); font-size: 12.5px; }
.course h4 { font-size: 15.5px; }
.course p { color: var(--text-muted); font-size: 14px; }
.course a { color: var(--brand-violet); font-size: 13.5px; font-weight: 700; }
.research-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 20px; }
.research-item { padding: 22px; border: 1px solid rgba(90,46,166,.1); border-radius: 14px; background: #FFFFFF; text-align: center; }
.research-item h3 { font-size: 16.5px; }
.research-item p { color: var(--text-muted); font-size: 13.5px; }
.donate-band { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; padding: 36px 40px; border: 1px solid rgba(255,255,255,.12); border-radius: 16px; background: var(--sn-gradient); color: #FFFFFF; }
.donate-band h3 { color: #FFFFFF; }
.donate-band p { color: var(--lavender-soft); }
.donate-band .btn-primary { border-radius: 999px; background: linear-gradient(120deg, var(--brand-gold), var(--brand-gold-soft)); color: var(--brand-deep); }

/* Footer and utilities */
footer { position: relative; padding: 40px 0 20px; background: var(--sn-gradient); color: var(--lavender-light); }
.footer-grid { display: grid; grid-template-columns: 1.35fr repeat(4,1fr); gap: 24px; padding: 0 0 24px; }
.footer-brand { color: var(--lavender-light); font-family: 'Cormorant Garamond', serif; font-size: 19px; font-weight: 700; margin-bottom: 8px; }
footer h4 { color: var(--brand-gold); font-size: 13px; letter-spacing: 1px; margin-bottom: 12px; text-transform: uppercase; }
footer a { color: var(--lavender-light); text-decoration: none; }
.footer-social .social-link { display: flex; align-items: center; gap: 8px; color: #F3F0FA; }
.footer-social .social-link svg { width: 20px; height: 20px; fill: #F3F0FA; }
.footer-bottom { padding: 16px 0 0; border-top: 1px solid rgba(255,255,255,.16); color: var(--lavender-muted); text-align: center; font-size: 12.5px; }
#backToTop { position: fixed; right: 24px; bottom: 96px; z-index: 999; width: 46px; height: 46px; border: 0; border-radius: 50%; background: linear-gradient(135deg,var(--brand-violet),var(--brand-violet-light)); color: #FFFFFF; opacity: 0; pointer-events: none; transform: translateY(12px); transition: opacity .3s ease, transform .3s ease; }
#backToTop.show { opacity: 1; pointer-events: auto; transform: translateY(0); }

/* Legacy reveal behavior */
.reveal, .stagger > * { opacity: 0; transform: translateY(22px); }
.reveal.in, .stagger.in > * { opacity: 1; transform: translateY(0); }

@keyframes headerSlideIn { from { transform: translateY(-100%); } to { transform: translateY(0); } }
@keyframes logoOrbit { to { transform: rotate(360deg); } }
@keyframes logoOrbitReverse { to { transform: rotate(-360deg); } }
@keyframes logoBreath { 0%,100% { transform: scale(1); } 50% { transform: scale(1.045); } }
@keyframes navSheen { 0%,65% { left: -35%; } 100% { left: 125%; } }
@keyframes gopuramGlow { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }
@keyframes heroOrbit { to { transform: rotate(360deg); } }
@keyframes heroSparkle { 0%,100% { opacity: .35; } 50% { opacity: .8; } }
@keyframes cloudDrift { from { margin-left: 0; } to { margin-left: calc(100vw + 620px); } }

@media (max-width: 900px) {
  nav.links { display: none; }
  .hamburger { display: flex; }
  .tablet-grid, .research-grid { grid-template-columns: repeat(2,1fr); }
  .course-grid { grid-template-columns: 1fr; }
  .about-grid { grid-template-columns: 1fr; }
  .footer-grid { grid-template-columns: repeat(2,1fr); }
}
@media (max-width: 700px) {
  header { padding: 8px 0; }
  .hero { padding: 42px 0 66px; min-height: 190px; }
  .hero h1 { font-size: clamp(34px,10vw,46px); white-space: normal; }
  .stats-grid { grid-template-columns: repeat(2,1fr); gap: 24px; }
}
@media (max-width: 560px) {
  .tablet-grid, .research-grid { grid-template-columns: 1fr; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: .001ms !important; transition-duration: .001ms !important; }
  .reveal, .stagger > * { opacity: 1; transform: none; }
}

/* Independent initiatives */
.independent-initiatives { padding: 78px 0 84px; background: linear-gradient(135deg,rgba(245,241,253,.96),rgba(232,222,249,.88)); }
.independent-initiatives::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 12% 22%,rgba(125,82,190,.10),transparent 28%), radial-gradient(circle at 90% 78%,rgba(181,160,225,.14),transparent 30%); pointer-events: none; }
.independent-initiatives .wrap { position: relative; z-index: 1; }
.independent-initiatives .section-head { margin-bottom: 34px; }
.independent-list { display: grid; gap: 0; }
.independent-list .initiative-item { display: flex; align-items: flex-start; gap: 24px; padding: 30px 4px; border: 0; border-top: 1px solid rgba(93,62,145,.20); border-bottom: 1px solid rgba(93,62,145,.20); background: transparent; transition: padding-left .3s ease, background .3s ease; }
.independent-list .initiative-item + .initiative-item { border-top: 0; }
.independent-list .initiative-item:hover { padding-left: 14px; background: linear-gradient(90deg,rgba(69,33,139,.18),rgba(105,51,201,.08),transparent); }
.independent-list .initiative-icon { flex: 0 0 58px; width: 58px; height: 58px; display: grid; place-items: center; border-radius: 50%; background: linear-gradient(135deg,#f6f0ff,#e6dafa); color: var(--brand-deep); font-weight: 700; box-shadow: 0 8px 20px rgba(84,53,142,.10); }
.independent-list .initiative-body { flex: 1; }
.independent-list .initiative-body h4 { margin: 0 0 8px; color: var(--brand-deep); font-size: 26px; }
.independent-list .initiative-body p { max-width: 820px; margin: 0 0 16px; color: var(--text-muted); line-height: 1.65; }
.initiative-link-button { display: inline-flex; align-items: center; gap: 8px; padding: 10px 17px; border: 1px solid rgba(80,39,143,.28); border-radius: 999px; background: linear-gradient(135deg,#f4edff,#e4d5fb); color: var(--brand-deep); font-weight: 700; font-size: 14px; text-decoration: none; }

/* Subscribe */
.subscribe-section { padding: 70px 0; background: var(--lavender); }
.subscribe-wrap { max-width: 1000px; }
.subscribe-heading { margin-bottom: 30px; text-align: center; }
.subscribe-heading h2 { margin: 14px 0; }
.subscribe-heading p { max-width: 680px; margin: 0 auto; color: var(--text-muted); }
.subscribe-card { padding: 32px; border: 1px solid rgba(255,255,255,.12); border-top: 4px solid var(--brand-gold); border-radius: 16px; background: var(--sn-gradient); color: #FFFFFF; box-shadow: 0 10px 30px rgba(59,42,107,.35); }
.subscribe-card-inner { display: flex; align-items: flex-start; gap: 16px; flex-wrap: wrap; }
.subscribe-mark { width: 54px; height: 54px; flex-shrink: 0; display: grid; place-items: center; border-radius: 50%; background: rgba(255,255,255,.15); color: #FFFFFF; font-size: 22px; }
.subscribe-content { flex: 1; min-width: 240px; }
.subscribe-content h3 { margin: 0 0 4px; color: #FFFFFF; font-size: 20px; }
.subscribe-label, .subscribe-field label { color: var(--brand-gold); font-size: 12.5px; font-weight: 700; letter-spacing: 1px; }
.subscribe-description { margin: 0 0 20px; color: var(--lavender-soft); font-size: 14.5px; }
.subscribe-fields { display: flex; gap: 14px; flex-wrap: wrap; }
.subscribe-field { flex: 1; min-width: 160px; }
.subscribe-field label { display: block; margin-bottom: 6px; font-size: 11.5px; }
.subscribe-field input { width: 100%; padding: 11px 12px; border: 0; border-radius: 8px; background: rgba(255,255,255,.12); color: #FFFFFF; }
.subscribe-field input::placeholder { color: rgba(255,255,255,.65); }
.subscribe-submit-wrap { display: flex; align-items: flex-end; }
.subscribe-submit-wrap button { padding: 12px 22px; border: 0; border-radius: 8px; background: linear-gradient(120deg,var(--brand-gold),var(--brand-gold-soft)); color: var(--brand-deep); font-weight: 700; cursor: pointer; }
.subscribe-note { margin: 14px 0 0; color: var(--lavender-muted); font-size: 12px; }
.subscribe-status { color: var(--brand-gold); font-size: 13px; }

/* Contact and modal */
#contact { background: var(--lavender-light); }
.contact-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 56px; margin-top: 20px; }
.contact-grid h3 { font-size: 20px; }
.contact-grid p, .meta-line { color: var(--text-secondary); }
.contact-grid form { display: grid; gap: 13px; }
.contact-grid input, .contact-grid textarea { width: 100%; padding: 13px 14px; border: 1px solid #e4def3; border-radius: 12px; background: #F9F7FE; color: var(--text-primary); font: inherit; }
.contact-grid textarea { min-height: 132px; resize: vertical; }
.modal-overlay { position: fixed; inset: 0; z-index: 1000; display: none; align-items: center; justify-content: center; padding: 20px; background: rgba(28,20,54,.45); }
.modal-overlay.open { display: flex; }
.modal-box { position: relative; width: 100%; max-width: 420px; padding: 32px; border-radius: 16px; background: #FFFFFF; box-shadow: 0 24px 60px rgba(28,20,54,.3); }
.modal-close { position: absolute; top: 14px; right: 16px; border: 0; background: none; color: var(--lavender-subtle); font-size: 22px; cursor: pointer; }
.modal-box form { display: flex; flex-direction: column; gap: 12px; }
.modal-box input, .modal-box select { width: 100%; padding: 12px 14px; border: 1px solid rgba(90,46,166,.2); border-radius: 9px; font: inherit; }
.modal-success { padding: 12px; border-radius: 8px; background: #E8F5E9; color: #2D6A37; font-size: 14px; }

/* WhatsApp floating control */
.whatsapp-float {
  position: fixed;
  right: 24px;
  bottom: 24px;
  z-index: 999;
  display: flex;
  align-items: center;
  gap: 10px;
}

.wa-btn {
  position: relative;
  width: 56px;
  height: 56px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #25D366;
  box-shadow: 0 8px 20px rgba(37,211,102,.35);
}

.wa-btn svg {
  width: 28px;
  height: 28px;
  fill: #FFFFFF;
  display: block;
}

.wa-ring {
  position: absolute;
  inset: -6px;
  border: 2px solid rgba(37,211,102,.55);
  border-radius: 50%;
  pointer-events: none;
  animation: waRing 2.4s ease-out infinite;
}

.wa-tooltip {
  padding: 8px 12px;
  border-radius: 8px;
  background: #20154A;
  color: #FFFFFF;
  font-size: 12.5px;
  white-space: nowrap;
  opacity: 0;
  transform: translateX(6px);
  transition: opacity .25s ease, transform .25s ease;
}

.whatsapp-float:hover .wa-tooltip {
  opacity: 1;
  transform: translateX(0);
}

@keyframes waRing {
  0% { transform: scale(.9); opacity: .9; }
  100% { transform: scale(1.6); opacity: 0; }
}

@media (max-width: 650px) {
  .independent-list .initiative-item { gap: 15px; padding: 24px 0; }
  .independent-list .initiative-icon { flex-basis: 48px; width: 48px; height: 48px; }
  .independent-list .initiative-body h4 { font-size: 21px; }
}

/* ============================================================
   FINAL FOOTER OVERRIDES — tighter spacing + darker background
   ============================================================ */

footer {
  background: linear-gradient(115deg, #1F0F47 0%, #2E1560 43%, #4A1E9E 100%) !important;
  padding: 40px 0 20px !important;
}

.footer-grid {
  display: grid !important;
  grid-template-columns: 1.35fr repeat(4, 1fr) !important;
  gap: 24px !important;
  padding: 0 0 24px !important;
}

.footer-grid h4 {
  font-size: 13px !important;
  letter-spacing: 1px !important;
  margin-bottom: 12px !important;
  color: var(--brand-gold) !important;
  text-transform: uppercase !important;
}

.footer-grid > div > a {
  display: block !important;
  font-size: 14px !important;
  text-decoration: none !important;
  margin-bottom: 8px !important;
  color: var(--lavender-light) !important;
  line-height: 1.5 !important;
  padding: 0 !important;
}

.footer-grid > div > a:hover {
  color: var(--brand-gold) !important;
  transform: translateX(4px);
}

.footer-grid p {
  font-size: 14px !important;
  max-width: 260px !important;
  line-height: 1.6 !important;
  color: var(--lavender-muted) !important;
  margin: 0 0 8px 0 !important;
}

.footer-brand {
  color: var(--lavender-light) !important;
  font-family: 'Cormorant Garamond', serif !important;
  font-size: 19px !important;
  font-weight: 700 !important;
  margin-bottom: 8px !important;
}

.footer-social h4 {
  margin-bottom: 12px !important;
}

.footer-social .social-icons {
  display: flex !important;
  flex-direction: column !important;
  gap: 8px !important;
}

.footer-social .social-link {
  display: flex !important;
  align-items: center !important;
  gap: 8px !important;
  text-decoration: none !important;
  margin: 0 !important;
  color: #F3F0FA !important;
  padding: 0 !important;
  line-height: 1.4 !important;
}

.footer-social .social-link:hover {
  color: var(--brand-gold) !important;
  transform: translateX(4px);
}

.footer-social .social-link svg {
  width: 20px !important;
  height: 20px !important;
  fill: currentColor !important;
  flex: 0 0 20px !important;
}

.footer-social .social-link span:last-child {
  font-size: 14px !important;
}

.footer-social .pivotra-icon {
  width: 20px !important;
  height: 20px !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  flex: 0 0 20px !important;
  border: 1px solid currentColor !important;
  border-radius: 50% !important;
  font-size: 12px !important;
  font-weight: 700 !important;
  line-height: 1 !important;
}

.footer-bottom {
  padding: 16px 0 0 !important;
  border-top: 1px solid rgba(255,255,255,0.12) !important;
  font-size: 12.5px !important;
  text-align: center !important;
  color: var(--lavender-muted) !important;
}

@media (max-width: 900px) {
  .footer-grid {
    grid-template-columns: 1fr 1fr !important;
  }
}

@media (max-width: 560px) {
  .footer-grid {
    grid-template-columns: 1fr !important;
  }
  .footer-social .social-icons {
    display: grid !important;
    grid-template-columns: 1fr 1fr !important;
    gap: 10px !important;
  }
}

/* ============================================================
   GOLD DIVIDER — thin line between page content and footer
   ============================================================ */

footer::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--brand-gold), transparent);
  background-size: 200% 100%;
  animation: gopuramGlow 6s ease-in-out infinite;
  opacity: 0.9;
  z-index: 2;
}

/* ============================================================
   REVEAL ON SCROLL — elements appear as they enter the viewport
   ============================================================ */

.section-head,
.tablet,
.course,
.research-item,
.vision-card {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity .8s cubic-bezier(.22, 1, .36, 1),
              transform .8s cubic-bezier(.22, 1, .36, 1);
}

.section-head.in,
.tablet.in,
.course.in,
.research-item.in,
.vision-card.in {
  opacity: 1;
  transform: translateY(0);
}

/* Stagger cards in a grid */
.tablet:nth-child(1) { transition-delay: 0s; }
.tablet:nth-child(2) { transition-delay: .08s; }
.tablet:nth-child(3) { transition-delay: .16s; }
.tablet:nth-child(4) { transition-delay: .24s; }

.course:nth-child(1) { transition-delay: 0s; }
.course:nth-child(2) { transition-delay: .08s; }
.course:nth-child(3) { transition-delay: .16s; }

.research-item:nth-child(1) { transition-delay: 0s; }
.research-item:nth-child(2) { transition-delay: .08s; }
.research-item:nth-child(3) { transition-delay: .16s; }
.research-item:nth-child(4) { transition-delay: .24s; }

@media (prefers-reduced-motion: reduce) {
  .section-head,
  .tablet,
  .course,
  .research-item,
  .vision-card {
    opacity: 1;
    transform: none;
    transition: none;
  }
}

/* ============================================================
   ABOUT SECTION BUTTON — purple pill button
   ============================================================ */

.about-grid .btn-primary {
  display: inline-block !important;
  padding: 13px 26px !important;
  border: none !important;
  border-radius: 10px !important;
  background: linear-gradient(120deg, #5B2AA6, #7B3FD4) !important;
  color: #FFFFFF !important;
  font-size: 14.5px !important;
  font-weight: 700 !important;
  text-decoration: none !important;
  text-align: center;
  margin-top: 8px;
  cursor: pointer;
  transition: transform .25s ease, box-shadow .25s ease, filter .25s ease;
}

.about-grid .btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 22px rgba(91, 42, 166, 0.32);
  filter: brightness(1.05);
}

/* ============================================================
   COURSE GRID — ensure 3 columns on desktop (fix stray 1fr)
   ============================================================ */

.course-grid {
  display: grid !important;
  grid-template-columns: repeat(3, 1fr) !important;
  gap: 22px !important;
}

@media (max-width: 900px) {
  .course-grid {
    grid-template-columns: 1fr !important;
  }
}


/* ============================================================
   DONATE BAND BUTTON — gold pill button (matches HTML)
   ============================================================ */

#donate .donate-band .btn-primary,
.donate-band .btn-primary {
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  padding: 13px 26px !important;
  border: none !important;
  border-radius: 999px !important;
  background: linear-gradient(120deg, var(--brand-gold), var(--brand-gold-soft)) !important;
  color: var(--brand-deep) !important;
  font-size: 14.5px !important;
  font-weight: 700 !important;
  text-decoration: none !important;
  white-space: nowrap;
  cursor: pointer;
  transition: transform .25s ease, box-shadow .25s ease, filter .25s ease;
  flex-shrink: 0;
}

#donate .donate-band .btn-primary:hover,
.donate-band .btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 22px rgba(232, 195, 74, 0.42);
  filter: brightness(1.05);
}

#donate .donate-band .btn-primary:focus,
.donate-band .btn-primary:focus {
  outline: none;
  box-shadow: 0 0 0 3px rgba(232, 195, 74, 0.45);
}



/* ============================================================
   DONATE BAND — gold outline border
   ============================================================ */

#donate .donate-band,
.donate-band {
  border: 1px solid rgba(232, 195, 74, 0.55) !important;
  box-shadow: 0 0 0 1px rgba(232, 195, 74, 0.15),
              0 12px 32px rgba(48, 28, 88, 0.18) !important;
}





/* ============================================================
   DONATE BAND — thicker gold outline + breathing animation
   ============================================================ */

@keyframes donateBandBreath {
  0%, 100% {
    box-shadow:
      0 0 0 2px rgba(232, 195, 74, 0.55),
      0 0 12px 2px rgba(232, 195, 74, 0.18),
      0 12px 32px rgba(48, 28, 88, 0.18);
    border-color: rgba(232, 195, 74, 0.55);
  }
  50% {
    box-shadow:
      0 0 0 2px rgba(232, 195, 74, 0.85),
      0 0 22px 6px rgba(232, 195, 74, 0.35),
      0 12px 32px rgba(48, 28, 88, 0.18);
    border-color: rgba(232, 195, 74, 0.95);
  }
}

#donate .donate-band,
.donate-band {
  border: 2px solid rgba(232, 195, 74, 0.55) !important;
  animation: donateBandBreath 4s ease-in-out infinite;
}



/* ============================================================
   DONATE BAND — tighter, bolder, thicker gold outline
   ============================================================ */

@keyframes donateBandBreath {
  0%, 100% {
    box-shadow:
      0 0 0 5px rgba(232, 195, 74, 0.55),
      0 0 18px 4px rgba(232, 195, 74, 0.22),
      0 12px 32px rgba(48, 28, 88, 0.18);
    border-color: rgba(232, 195, 74, 0.60);
  }
  50% {
    box-shadow:
      0 0 0 5px rgba(232, 195, 74, 0.90),
      0 0 28px 8px rgba(232, 195, 74, 0.40),
      0 12px 32px rgba(48, 28, 88, 0.18);
    border-color: rgba(232, 195, 74, 1);
  }
}

#donate .donate-band,
.donate-band {
  padding: 28px 32px !important;
  border: 5px solid rgba(232, 195, 74, 0.60) !important;
  animation: donateBandBreath 4s ease-in-out infinite;
  gap: 20px !important;
}

#donate .donate-band h3,
.donate-band h3 {
  font-size: 28px !important;
  font-weight: 700 !important;
  margin: 0 0 6px 0 !important;
  color: #FFFFFF !important;
}

#donate .donate-band p,
.donate-band p {
  font-size: 17px !important;
  line-height: 1.5 !important;
  margin: 0 !important;
  color: #DED7EE !important;
  max-width: 620px !important;
}


/* ============================================================
   HEADER ACTIONS — Login, Sign Up, Donate buttons
   ============================================================ */

.header-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.header-actions .btn-outline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 9px 20px;
  border: 1.5px solid rgba(255, 255, 255, 0.6);
  border-radius: 999px;
  background: transparent;
  color: #FFFFFF;
  font-size: 14px;
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
  transition: all .25s ease;
}

.header-actions .btn-outline:hover {
  background: rgba(255, 255, 255, 0.12);
  border-color: #FFFFFF;
}

.header-actions .btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 9px 22px;
  border: none;
  border-radius: 999px;
  background: linear-gradient(120deg, var(--brand-violet), var(--brand-violet-light));
  color: #FFFFFF;
  font-size: 14px;
  font-weight: 700;
  text-decoration: none;
  cursor: pointer;
  transition: transform .25s ease, box-shadow .25s ease;
}

.header-actions .btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(105, 51, 201, 0.35);
}

/* Hide buttons on mobile — only show hamburger */
@media (max-width: 900px) {
  .header-actions {
    display: none;
  }
}