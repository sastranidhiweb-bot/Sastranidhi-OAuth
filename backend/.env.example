# # ============================================================
# # Sastranidhi OAuth Server — Environment Configuration
# # Copy this file to .env and fill in real values.
# # NEVER commit the real .env file.
# # ============================================================

# # --- App ---
# NODE_ENV=development
# PORT=4000
# ISSUER=https://auth.sastranidhi.org
# # Comma-separated list of origins allowed to call this server (child apps + main portal)
# ALLOWED_ORIGINS=https://sastranidhi.org,https://puranatilakam.sastranidhi.org,https://www.ebook-lib.sastranidhi.org,https://pariprashna.sastranidhi.org,https://lms.sastranidhi.org,http://localhost:3000

# # --- MySQL ---
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=sastranidhi_oauth
# DB_PASSWORD=change_me
# DB_NAME=sastranidhi_oauth
# DB_POOL_MIN=2
# DB_POOL_MAX=10

# # --- Redis ---
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# # --- Sessions (used for the login/consent flow, backed by Redis) ---
# SESSION_SECRET=change_me_to_a_long_random_string
# SESSION_COOKIE_NAME=sastranidhi.sid
# SESSION_COOKIE_DOMAIN=.sastranidhi.org
# SESSION_MAX_AGE_MS=1800000

# # --- JWT (RS256 — see keys/ and scripts/generate-keys.js) ---
# JWT_PRIVATE_KEY_PATH=./keys/private.pem
# JWT_PUBLIC_KEY_PATH=./keys/public.pem
# JWT_KEY_ID=sastranidhi-key-1
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=30d

# # --- Security ---
# BCRYPT_SALT_ROUNDS=12
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100

# # --- Social login (module 5) ---
# # Leave a provider's *_CLIENT_ID unset to skip registering that strategy —
# # the server boots fine without these; /auth/google and /auth/microsoft
# # just won't be available until configured.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_CALLBACK_URL=http://localhost:4000/auth/microsoft/callback
# MICROSOFT_TENANT=common

# # --- MFA (module 5) ---
# MFA_ISSUER_NAME=Sastranidhi
# MFA_CHALLENGE_EXPIRES_IN_SECONDS=300

# # --- Portal / email verification / password reset (module 7) ---
# # The React portal that now owns the login/signup UI. /oauth/authorize
# # redirects here (not this backend's own placeholder page) when a request
# # arrives with no valid session, and it's the one extra origin (besides a
# # path starting with "/") that returnTo values are allowed to point at —
# # see src/utils/returnTo.js.
# FRONTEND_BASE_URL=http://localhost:5173

# # 'console' (default) logs verification codes / reset links via the
# # server's own logger instead of sending real email — good enough for all
# # local dev/testing. Set to 'smtp' + the vars below for production, and
# # run `npm install nodemailer` first (not a dependency by default).
# EMAIL_TRANSPORT=console
# EMAIL_FROM="Sastranidhi <no-reply@sastranidhi.org>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# # --- Logging ---
# LOG_LEVEL=info
